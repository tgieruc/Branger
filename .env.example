# Supabase project configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Edge function secrets (set in Supabase dashboard, not here)
# MISTRAL_API_KEY=your-mistral-key

# Optional EAS project configuration (public identifiers)
EAS_PROJECT_ID=
EAS_OWNER=

# Edge function secret: comma-separated trusted HTTPS recipe hosts.
# URL imports are disabled until this is configured. Redirect hosts must also be listed.
# RECIPE_ALLOWED_HOSTS=recipes.example.com
